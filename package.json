{
  "description": "Baba Is You (simplified) — single-file web build",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@types/three": "^0.186.0",
    "esbuild": "^0.28.2",
    "fire-keeper": "^0.0.239",
    "oxlint": "1.82.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "wrangler": "4.101.0"
  },
  "license": "MIT",
  "name": "baba-is-you",
  "scripts": {
    "build": "node scripts/build-single-html.mjs",
    "check": "pnpm lint && pnpm type-check && pnpm test",
    "deploy": "pnpm build && wrangler deploy",
    "import-levels:official": "tsx src/tools/import-official-levels.ts",
    "verify-levels:official": "tsx src/tools/import-official-levels.ts --verify",
    "lint": "tsx scripts/remove-bom.ts && tsx scripts/fix-crlf.ts && oxlint",
    "simulate": "tsx scripts/simulate.ts",
    "test": "tsx --test 'src/**/*.test.ts'",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "watch": "node scripts/watch-build.mjs",
    "wt-rebase": "node scripts/worktree/rebase-worktree.js --base main",
    "wt-land": "node scripts/worktree/land-worktree.js --base main --plans-dir plans"
  },
  "packageManager": "pnpm@11.8.0",
  "type": "module",
  "version": "0.1.0",
  "dependencies": {
    "n8ao": "2.0.1",
    "postprocessing": "6.39.5",
    "three": "^0.183.1"
  }
}
