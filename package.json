{
  "bin": {
    "baba-cli": "./src/cli.ts"
  },
  "description": "Terminal Baba Is You (simplified) CLI",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@types/three": "^0.186.0",
    "esbuild": "^0.28.2",
    "fire-keeper": "^0.0.239",
    "oxlint": "1.82.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "main": "src/index.ts",
  "name": "baba-is-you-cli",
  "scripts": {
    "build": "node scripts/build-single-html.mjs",
    "check": "pnpm lint && pnpm type-check && pnpm test",
    "import-levels:official": "tsx src/tools/import-official-levels.ts",
    "verify-levels:official": "tsx src/tools/import-official-levels.ts --verify",
    "lint": "tsx scripts/remove-bom.ts && tsx scripts/fix-crlf.ts && oxlint",
    "simulate": "tsx scripts/simulate.ts",
    "start": "tsx src/cli.ts",
    "test": "tsx --test src/**/*.test.ts",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "watch": "node scripts/watch-build.mjs",
    "wt-rebase": "node scripts/worktree/rebase-worktree.js --base main",
    "wt-land": "node scripts/worktree/land-worktree.js --base main --plans-dir plans"
  },
  "packageManager": "pnpm@11.8.0",
  "type": "module",
  "version": "0.1.0",
  "dependencies": {
    "three": "^0.183.1"
  }
}
